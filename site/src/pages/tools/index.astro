---
import Base from '../../layouts/Base.astro';
---
<Base title="Free tools for quotes and invoices" description="Free calculators and tools for freelancers and small businesses." canonicalPath="/tools/">
  <div class="container-x py-12">
    <h1 class="text-4xl font-bold tracking-tight">Free tools</h1>
    <p class="mt-3 max-w-2xl text-[var(--muted)]">Interactive tools will be listed here. Each tool is a small plain-JavaScript island.</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      <li class="card">
        <h2 class="text-lg font-semibold">Example: line total</h2>
        <form id="calc" class="mt-3 grid gap-3">
          <label class="grid gap-1 text-sm font-medium">Quantity <input class="rounded-md border border-[var(--line)] bg-[var(--bg)] p-2" name="qty" type="number" min="0" step="any" value="1" /></label>
          <label class="grid gap-1 text-sm font-medium">Unit price <input class="rounded-md border border-[var(--line)] bg-[var(--bg)] p-2" name="price" type="number" min="0" step="any" value="100" /></label>
          <label class="grid gap-1 text-sm font-medium">Tax % <input class="rounded-md border border-[var(--line)] bg-[var(--bg)] p-2" name="tax" type="number" min="0" step="any" value="0" /></label>
        </form>
        <p class="mt-4">Total: <strong id="total" aria-live="polite">100.00</strong></p>
      </li>
    </ul>
  </div>
  <script>
    const f = document.getElementById('calc') as HTMLFormElement;
    const out = document.getElementById('total')!;
    const run = () => {
      const v = (n: string) => Number((f.elements.namedItem(n) as HTMLInputElement).value) || 0;
      out.textContent = (v('qty') * v('price') * (1 + v('tax') / 100)).toFixed(2);
    };
    f.addEventListener('input', run);
  </script>
</Base>
