---
import Base from '../../layouts/Base.astro';
import AppCta from '../../components/AppCta.astro';
import { getCollection, render } from 'astro:content';
import { markets, articleUrl, abs, SITE } from '../../lib/markets';

export async function getStaticPaths() {
  const all = await getCollection('articles');
  return all
    .filter((a) => a.data.market !== 'global')
    .map((entry) => ({
      params: { market: markets[entry.data.market].path, slug: entry.data.slug },
      props: { entry, all },
    }));
}
const { entry, all } = Astro.props;
const d = entry.data;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const info = markets[d.market];
const path = articleUrl(d.market, d.slug);

const siblings = d.hreflangGroup ? all.filter((a) => a.data.hreflangGroup === d.hreflangGroup) : [entry];
const alternates = siblings.map((a) => ({ hreflang: markets[a.data.market].hreflang, href: abs(articleUrl(a.data.market, a.data.slug)) }));
if (d.hreflangGroup) {
  const dflt = siblings.find((a) => a.data.market === 'global') ?? siblings.find((a) => a.data.market === 'us');
  if (dflt) alternates.push({ hreflang: 'x-default', href: abs(articleUrl(dflt.data.market, dflt.data.slug)) });
}
const iso = (x: Date) => x.toISOString().slice(0, 10);
const jsonLd: object[] = [
  {
    '@context': 'https://schema.org', '@type': 'Article', headline: d.title, description: d.description,
    datePublished: iso(d.published), dateModified: iso(d.updated), mainEntityOfPage: abs(path),
    inLanguage: info.lang, publisher: { '@type': 'Organization', name: 'Quotation Maker Pro', url: SITE },
  },
  {
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: abs('/') },
      { '@type': 'ListItem', position: 2, name: info.name, item: abs(`/${info.path}/`) },
      { '@type': 'ListItem', position: 3, name: d.title, item: abs(path) },
    ],
  },
];
if (d.faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: d.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
  });
}
---
<Base title={d.title} description={d.description} lang={info.lang} canonicalPath={path} alternates={alternates} ogType="article" jsonLd={jsonLd}>
  <div class="container-x py-8 lg:grid lg:grid-cols-[minmax(0,70ch)_16rem] lg:justify-center lg:gap-12">
    <article class="prose-qmp">
      <nav class="mb-4 text-sm text-[var(--muted)]" aria-label="Breadcrumb"><a href="/">Home</a> / <a href={`/${info.path}/`}>{info.name}</a></nav>
      <h1>{d.title}</h1>
      <p class="text-sm text-[var(--muted)]">Last reviewed: {iso(d.lastReviewed)}</p>
      <Content />
      {d.faq.length > 0 && <section><h2>FAQ</h2>{d.faq.map((f) => <><h3>{f.q}</h3><p>{f.a}</p></>)}</section>}
      {d.sources.length > 0 && <section><h2>Sources</h2><ul>{d.sources.map((s) => <li><a href={s.url} rel="noopener">{s.title}</a></li>)}</ul></section>}
      <AppCta market={d.market} slug={d.slug} />
    </article>
    {toc.length > 1 && (
      <aside class="hidden lg:block" aria-label="On this page">
        <nav class="sticky top-6 text-sm">
          <p class="font-semibold">On this page</p>
          <ul class="mt-2 space-y-1.5 border-l border-[var(--line)] pl-3">
            {toc.map((h) => <li><a href={`#${h.slug}`} class="text-[var(--muted)] no-underline hover:text-[var(--link)]">{h.text}</a></li>)}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</Base>
