---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { hubMarkets, markets, articleUrl } from '../../lib/markets';

export function getStaticPaths() {
  return hubMarkets.map((m) => ({ params: { market: markets[m].path }, props: { m } }));
}
const { m } = Astro.props;
const info = markets[m];
const articles = (await getCollection('articles')).filter((a) => a.data.market === m);
const clusters = new Map<string, typeof articles>();
for (const a of articles) {
  const list = clusters.get(a.data.cluster) ?? [];
  list.push(a);
  clusters.set(a.data.cluster, list);
}
---
<Base title={`Quotes, estimates and invoicing guides: ${info.name}`} description={`Practical guides for ${info.name} freelancers and small businesses.`} lang={info.lang} canonicalPath={`/${info.path}/`}>
  <div class="container-x py-12">
    <h1 class="text-4xl font-bold tracking-tight">Guides for {info.name}</h1>
    {articles.length === 0 && <p class="mt-4 text-[var(--muted)]">Guides for this market are coming soon.</p>}
    {[...clusters].map(([name, list]) => (
      <section class="mt-10">
        <h2 class="text-2xl font-bold">{name}</h2>
        <ul class="mt-4 grid gap-3 sm:grid-cols-2">
          {list.map((a) => (
            <li><a href={articleUrl(m, a.data.slug)} class="card block h-full no-underline text-[var(--fg)] hover:border-[var(--link)]">
              <span class="font-semibold">{a.data.title}</span>
              <span class="mt-1 block text-sm text-[var(--muted)]">{a.data.description}</span>
            </a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
