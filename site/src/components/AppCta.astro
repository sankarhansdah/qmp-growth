---
import { PUBLISHED, playUrl } from '../lib/product';
import type { Market } from '../lib/markets';

interface Props { market: Market; slug: string; }
const { market, slug } = Astro.props;
const terms: Partial<Record<Market, string>> = { us: 'estimate', in: 'quotation', ae: 'quotation' };
const term = terms[market] ?? 'quote';
---
<aside class="cta card my-10" style="border-color: var(--link)" data-market={market}>
  <p class="mb-3">Doing every {term} by hand? Quotation Maker Pro fills in your business details, tax and totals automatically and exports a clean PDF. Free for 5 documents a month.</p>
  {PUBLISHED
    ? <a class="btn" rel="noopener" href={playUrl(slug)}>Get it on Google Play</a>
    : <p class="mb-0 font-semibold">Android app coming soon to Google Play.</p>}
</aside>
