---
import { PUBLISHED, playUrl } from '../lib/product';
import type { Market } from '../lib/markets';

interface Props { market: Market; slug: string; }
const { market, slug } = Astro.props;
const term = { us: 'estimate', in: 'quotation', ae: 'quotation' }[market] ?? 'quote';
---
<aside class="cta" data-market={market}>
  <p>Doing every {term} by hand? Quotation Maker Pro fills in your business details, tax and totals automatically and exports a clean PDF. Free for 5 documents a month.</p>
  {PUBLISHED
    ? <a class="btn" rel="noopener" href={playUrl(slug)}>Get it on Google Play</a>
    : <p><strong>Android app coming soon to Google Play.</strong></p>}
</aside>
